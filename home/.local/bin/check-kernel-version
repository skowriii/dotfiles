#!/usr/bin/env python3

import subprocess as s
import json
import re
import sys

version_regex = re.compile(r"[0-9]*\.[0-9]*\.[0-9]*")
kernelPackages_regex = re.compile(r"kernelPackages")

kernelPackage = ""
with open("/personal/nixos/config/boot.nix", 'r') as f:
    lines = f.readlines()
    for line in lines:
        if kernelPackages_regex.search(line):
            kernelPackage = line.split()[2].strip("pkgs.").strip(';')
            break

    f.close()

local_version = s.run(["uname", "-r"], capture_output=True).stdout.decode("utf-8")
local_version = version_regex.search(local_version)[0]

command = ["nix", "run", "nixpkgs#hydra-check", "--", f"{kernelPackage}.kernel", "--short", "--json"]
latest_version = s.run(command, capture_output=True).stdout.decode("utf-8")
latest_version = json.loads(latest_version)[f"nixpkgs.{kernelPackage}.kernel.x86_64-linux"][0]["name"]
latest_version = version_regex.search(latest_version)[0]

if local_version != latest_version:
    if sys.stdin and sys.stdin.isatty():
        print("Kernel is outdated!")
        print(f"Installed: \033[1;31m{local_version}\033[0;0m")
        print(f"Latest: \033[1;32m{latest_version}\033[0;0m")
    else:
        s.run(["nix",
               "run",
               "nixpkgs#libnotify",
               "--",
               "Kernel is outdated!",
               f"Installed: {local_version}\nLatest: {latest_version}"
             ])
